              ".validate": "newData.hasChildren(['memberId', 'seatKey', 'stateCode', 'chamber', 'response', 'submittedAt', 'votingPeriod']) && newData.child('memberId').val() === $memberId && newData.child('votingPeriod').val() === $period",

